From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GT1 Kernel Safety <gt1-kernel@localhost>
Date: Thu, 12 Nov 2026 10:00:00 +0700
Subject: [PATCH] fix(kernel): mirror CI GCC9 and Amlogic compatibility

Capture the tested inline CI source edits for full ROM builds.

---
diff --git a/arch/arm64/kernel/ftrace.c b/arch/arm64/kernel/ftrace.c
index 40ad08ac..67e8f82d 100644
--- a/arch/arm64/kernel/ftrace.c
+++ b/arch/arm64/kernel/ftrace.c
@@ -119,6 +119,7 @@ void prepare_ftrace_return(unsigned long *parent, unsigned long self_addr,
 	unsigned long old;
 	struct ftrace_graph_ent trace;
 	int err;
+	int trace_depth;
 
 	if (unlikely(atomic_read(&current->tracing_graph_pause)))
 		return;
@@ -137,7 +138,8 @@ void prepare_ftrace_return(unsigned long *parent, unsigned long self_addr,
 	if (!ftrace_graph_entry(&trace))
 		return;
 
-	err = ftrace_push_return_trace(old, self_addr, &trace.depth,
+	trace_depth = trace.depth;
+	err = ftrace_push_return_trace(old, self_addr, &trace_depth,
 				       frame_pointer, NULL);
 	if (err == -EBUSY)
 		return;
