diff --git a/kernel/trace/trace.c b/kernel/trace/trace.c
index b7c2012d..938d3ffe 100644
--- a/kernel/trace/trace.c
+++ b/kernel/trace/trace.c
@@ -7686,9 +7686,8 @@ void ftrace_dump(enum ftrace_dump_mode oops_dump_mode)
 		cnt++;
 
 		/* reset all but tr, trace, and overruns */
-		memset(&iter.seq, 0,
-		       sizeof(struct trace_iterator) -
-		       offsetof(struct trace_iterator, seq));
+		memset((char *)&iter + offsetof(struct trace_iterator, seq), 0,
+		       sizeof(iter) - offsetof(struct trace_iterator, seq));
 		iter.iter_flags |= TRACE_FILE_LAT_FMT;
 		iter.pos = -1;
 
diff --git a/mm/vmscan.c b/mm/vmscan.c
index 2ea4b002..e0447db1 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -1684,7 +1684,7 @@ static int too_many_isolated(struct pglist_data *pgdat, int file,
 	}
 
 #ifdef CONFIG_AMLOGIC_CMA
-	isolated -= node_page_state(pgdat, NR_CMA_ISOLATED);
+	isolated -= sum_zone_node_page_state(pgdat->node_id, NR_CMA_ISOLATED);
 #endif /* CONFIG_AMLOGIC_CMA */
 	/*
 	 * GFP_NOIO/GFP_NOFS callers are allowed to isolate more pages, so they
@@ -1698,7 +1698,7 @@ static int too_many_isolated(struct pglist_data *pgdat, int file,
 #ifdef CONFIG_AMLOGIC_CMA
 	WARN_ONCE(isolated > inactive,
 		  "isolated:%ld, cma:%ld, inactive:%ld, mask:%x, file:%d\n",
-		  isolated, node_page_state(pgdat, NR_CMA_ISOLATED),
+		  isolated, sum_zone_node_page_state(pgdat->node_id, NR_CMA_ISOLATED),
 		  inactive, sc->gfp_mask, file);
 #endif /* CONFIG_AMLOGIC_CMA */
 	return isolated > inactive;

