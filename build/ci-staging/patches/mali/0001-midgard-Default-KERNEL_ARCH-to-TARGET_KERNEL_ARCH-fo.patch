Subject: [PATCH] midgard: Default KERNEL_ARCH to TARGET_KERNEL_ARCH for Kati
 target resolution

---
 midgard/Android.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/midgard/Android.mk b/midgard/Android.mk
index cc78036..a465212 100644
--- a/midgard/Android.mk
+++ b/midgard/Android.mk
@@ -18,6 +18,7 @@ LOCAL_PATH := $(call my-dir)
 
 ifeq ($(TARGET_PREBUILT_KERNEL),)
 
+KERNEL_ARCH     ?= $(TARGET_KERNEL_ARCH)
 MALI_GPU_VARIANT ?= midgard
 MALI_DRV_VERSION ?= r28p0
 #MALI_PATH        := $(abspath $(call my-dir))
